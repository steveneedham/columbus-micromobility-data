.github/workflows/fleet-export.yml
yamlname: Columbus Micromobility Fleet Export

on:
  schedule:
    - cron: "*/30 * * * *"   # every 30 minutes
  workflow_dispatch:         # manual run

jobs:
  export:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repo
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: "3.11"

    - name: Install dependencies
      run: |
        pip install requests pandas matplotlib seaborn

    - name: Run fleet export script
      run: |
        python scripts/export_fleet.py

    - name: Commit & push results
      run: |
        git config user.name "GitHub Actions"
        git config user.email "actions@github.com"
        git add snapshots/ daily_summary/ plots/
        git commit -m "Automated fleet export $(date -u +"%Y-%m-%dT%H:%M:%SZ")" || echo "No changes to commit"
        git push
