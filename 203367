<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function () {
  "use strict";

  // ---- Load embedded data ----
  const data311 = JSON.parse(document.getElementById("data-311").textContent);
  const dataGbfs = JSON.parse(document.getElementById("data-gbfs").textContent);
  const dataPolicy = JSON.parse(document.getElementById("data-policy").textContent);

  const records311 = data311.records || [];
  const vehicles = (dataGbfs.vehicles || []).map(v => ({ ...v }));
  const boundaries = dataPolicy.boundaries || [];

  // ---- Priority heuristic (ported verbatim from source app) ----
  function normalizedPriority(complaintType) {
    const t = String(complaintType || "");
    if (/ada_ramp|entrance/i.test(t)) return "critical";
    if (/ada_concern|pile|sidewalk/i.test(t)) return "high";
    return "standard";
  }
  const PRIORITY_COLOR = { critical: "#dc2626", high: "#f97316", standard: "#64748b" };
  const COMPANY_COLOR = { Veo: "#0d9488", Spin: "#f97316" };

  // ---- Cross-vendor pile-up detection (ported verbatim from source app) ----
  function distanceMeters(a, b) {
    const latScale = 111320;
    const lngScale = 111320 * Math.cos(((a.lat + b.lat) / 2) * Math.PI / 180);
    return Math.hypot((a.lat - b.lat) * latScale, (a.lng - b.lng) * lngScale);
  }
  function detectPileups(vehicles) {
    const radius = 20;
    const cell = 0.00018;
    const buckets = new Map();
    vehicles.forEach((vehicle, index) => {
      const key = `${Math.floor(vehicle.lat / cell)}:${Math.floor(vehicle.lng / cell)}`;
      if (!buckets.has(key)) buckets.set(key, []);
      buckets.get(key).push(index);
    });
    const visited = new Set();
    const clusters = [];
    vehicles.forEach((vehicle, index) => {
      if (visited.has(index)) return;
      const queue = [index];
      const members = [];
      visited.add(index);
      while (queue.length) {
        const currentIndex = queue.pop();
        const current = vehicles[currentIndex];
        members.push(current);
        const cellLat = Math.floor(current.lat / cell);
        const cellLng = Math.floor(current.lng / cell);
        for (let y = -1; y <= 1; y += 1) {
          for (let x = -1; x <= 1; x += 1) {
            const neighbors = buckets.get(`${cellLat + y}:${cellLng + x}`) || [];
            neighbors.forEach(neighborIndex => {
              if (!visited.has(neighborIndex) && distanceMeters(current, vehicles[neighborIndex]) <= radius) {
                visited.add(neighborIndex);
                queue.push(neighborIndex);
              }
            });
          }
        }
      }
      const companies = [...new Set(members.map(member => member.company))];
      if (members.length >= 4 && companies.length > 1) {
        clusters.push({
          id: `GBFS-FLAG-${String(clusters.length + 1).padStart(3, "0")}`,
          vehicles: members,
          companies,
          lat: members.reduce((sum, member) => sum + member.lat, 0) / members.length,
          lng: members.reduce((sum, member) => sum + member.lng, 0) / members.length
        });
      }
    });
    return clusters.toSorted((a, b) => b.vehicles.length - a.vehicles.length);
  }

  const pileups = detectPileups(vehicles);

  // ---- Helpers ----
  function titleCase(str) {
    return String(str || "unknown").replace(/_/g, " ").replace(/\b\w/g, c => c.toUpperCase());
  }
  function fmtDateTime(iso) {
    if (!iso) return "unknown";
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
  }
  function esc(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
    }[c]));
  }

  // ---- Map init ----
  const map = L.map("map").setView([39.9612, -82.9988], 12);
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  }).addTo(map);

  // ---- 311 layer ----
  const layer311 = L.layerGroup();
  records311.forEach(rec => {
    if (typeof rec.latitude !== "number" || typeof rec.longitude !== "number") return;
    const priority = normalizedPriority(rec.complaint_type);
    const marker = L.circleMarker([rec.latitude, rec.longitude], {
      radius: 6,
      color: PRIORITY_COLOR[priority],
      fillColor: PRIORITY_COLOR[priority],
      fillOpacity: 0.75,
      weight: 1.5
    });
    const popup = `
      <div class="popup-title">${esc(rec.source_id || "unknown id")}</div>
      <div><b>Type:</b> ${esc(titleCase(rec.complaint_type))}</div>
      <div><b>Address:</b> ${esc(rec.address || "unknown")}</div>
      <div><b>Zone:</b> ${esc(rec.zone_id || "unknown")}</div>
      <div><b>Operator:</b> ${esc(rec.operator || "unknown")}</div>
      <div><b>Status:</b> ${esc(rec.status || "unknown")}</div>
      <div><b>Reported:</b> ${esc(fmtDateTime(rec.reported_at))}</div>
      <div><b>Council district:</b> ${esc(rec.council_district || "unknown")}</div>
      <div>${rec.source_url ? `<a href="${esc(rec.source_url)}" target="_blank" rel="noopener">Source record</a>` : ""}</div>
      <div class="review-note">Review signal, not a confirmed violation. Not an official City record system.</div>
    `;
    marker.bindPopup(popup);
    marker.addTo(layer311);
  });
  layer311.addTo(map);

  // ---- GBFS layer ----
  let gbfsMarkers = []; // {marker, vehicle}
  const layerGbfs = L.layerGroup();
  function buildGbfsLayer() {
    layerGbfs.clearLayers();
    gbfsMarkers = [];
    const opFilter = document.getElementById("operatorFilter").value;
    const availFilter = document.getElementById("availFilter").value;
    vehicles.forEach(v => {
      if (typeof v.lat !== "number" || typeof v.lng !== "number") return;
      if (opFilter !== "all" && v.company !== opFilter) return;
      if (availFilter === "available" && !v.available) return;
      if (availFilter === "unavailable" && v.available) return;
      const color = COMPANY_COLOR[v.company] || "#475569";
      const marker = L.circleMarker([v.lat, v.lng], {
        radius: 3.5,
        color: color,
        fillColor: color,
        fillOpacity: 0.85,
        weight: 1
      });
      const idShort = String(v.id || "").slice(0, 8);
      const popup = `
        <div class="popup-title">${esc(idShort)}</div>
        <div><b>Company:</b> ${esc(v.company || "unknown")}</div>
        <div><b>Type:</b> ${esc(v.type || "unknown")}</div>
        <div><b>Battery:</b> ${v.battery != null ? esc(v.battery) + "%" : "unknown"}</div>
        <div><b>Range:</b> ${v.range != null ? esc(v.range) + " mi" : "unknown"}</div>
        <div><b>Available:</b> ${esc(String(!!v.available))}</div>
        <div><b>Disabled:</b> ${esc(String(!!v.disabled))}</div>
        <div><b>Reserved:</b> ${esc(String(!!v.reserved))}</div>
        <div class="review-note">Source-labeled GBFS snapshot; positions may lag real-time.</div>
      `;
      marker.bindPopup(popup);
      marker.addTo(layerGbfs);
      gbfsMarkers.push({ marker, vehicle: v });
    });
  }
  buildGbfsLayer();
  layerGbfs.addTo(map);

  // ---- Pile-up layer ----
  const layerPileups = L.layerGroup();
  pileups.forEach(cluster => {
    const marker = L.circleMarker([cluster.lat, cluster.lng], {
      radius: 14,
      color: "#dc2626",
      fillColor: "#dc2626",
      fillOpacity: 0.08,
      weight: 2.5
    });
    const popup = `
      <div class="popup-title">${esc(cluster.id)}</div>
      <div><b>Vehicles in cluster:</b> ${cluster.vehicles.length}</div>
      <div><b>Companies:</b> ${esc(cluster.companies.join(", "))}</div>
      <div class="review-note">Proximity-based clustering signal only — does not confirm a policy violation.</div>
    `;
    marker.bindPopup(popup);
    marker.addTo(layerPileups);
  });
  layerPileups.addTo(map);

  // ---- Policy boundaries layer ----
  const layerPolicy = L.geoJSON(
    boundaries.map(b => ({
      type: "Feature",
      properties: {
        policy_name: b.policy_name,
        boundary_type: b.boundary_type,
        description: b.description
      },
      geometry: b.geometry
    })),
    {
      style: { color: "#7c3aed", weight: 2, dashArray: "6,5", fillColor: "#7c3aed", fillOpacity: 0.06 },
      onEachFeature: (feature, lyr) => {
        const p = feature.properties || {};
        lyr.bindPopup(`
          <div class="popup-title">${esc(p.policy_name || "Unnamed policy")}</div>
          <div><b>Type:</b> ${esc(titleCase(p.boundary_type))}</div>
          <div><b>Description:</b> ${esc(p.description || "")}</div>
          <div class="review-note">Published policy boundary, not a real-time enforcement zone.</div>
        `);
      }
    }
  );
  layerPolicy.addTo(map);

  // ---- Toggles ----
  document.getElementById("toggle311").addEventListener("change", e => {
    if (e.target.checked) map.addLayer(layer311); else map.removeLayer(layer311);
  });
  document.getElementById("toggleGbfs").addEventListener("change", e => {
    if (e.target.checked) map.addLayer(layerGbfs); else map.removeLayer(layerGbfs);
  });
  document.getElementById("togglePileups").addEventListener("change", e => {
    if (e.target.checked) map.addLayer(layerPileups); else map.removeLayer(layerPileups);
  });
  document.getElementById("togglePolicy").addEventListener("change", e => {
    if (e.target.checked) map.addLayer(layerPolicy); else map.removeLayer(layerPolicy);
  });
  document.getElementById("operatorFilter").addEventListener("change", () => {
    buildGbfsLayer();
    if (document.getElementById("toggleGbfs").checked) { layerGbfs.addTo(map); }
  });
  document.getElementById("availFilter").addEventListener("change", () => {
    buildGbfsLayer();
    if (document.getElementById("toggleGbfs").checked) { layerGbfs.addTo(map); }
  });

  // ---- Stat cards ----
  function buildStats() {
    const statGrid = document.getElementById("statGrid");
    const statusCounts = {};
    records311.forEach(r => {
      const s = r.status || "unknown";
      statusCounts[s] = (statusCounts[s] || 0) + 1;
    });
    const statusSub = Object.entries(statusCounts)
      .map(([k, v]) => `${titleCase(k)}: ${v}`)
      .join(" · ") || "No status data";

    const companyCounts = {};
    vehicles.forEach(v => {
      const c = v.company || "unknown";
      companyCounts[c] = (companyCounts[c] || 0) + 1;
    });
    const companySub = Object.entries(companyCounts)
      .map(([k, v]) => `${k}: ${v}`)
      .join(" · ") || "No vehicle data";

    const cards = [
      {
        label: "311 records loaded",
        value: records311.length,
        sub: statusSub
      },
      {
        label: "GBFS vehicles loaded",
        value: vehicles.length,
        sub: companySub
      },
      {
        label: "Cross-vendor pile-ups detected",
        value: pileups.length,
        sub: pileups.length ? "≥4 vehicles, 2+ companies, within 20m" : "None found in this partial sample"
      },
      {
        label: "Policy boundaries loaded",
        value: boundaries.length,
        sub: `of ${dataPolicy.summary && dataPolicy.summary.boundary_feature_count != null ? dataPolicy.summary.boundary_feature_count : "?"} published (partial sample)`
      }
    ];
    statGrid.innerHTML = cards.map(c => `
      <div class="card">
        <div class="label">${esc(c.label)}</div>
        <div class="value">${esc(c.value)}</div>
        <div class="sub">${esc(c.sub)}</div>
      </div>
    `).join("");
  }
  buildStats();

  // ---- Sidebar pile-up list ----
  function buildPileupList() {
    const list = document.getElementById("pileupList");
    if (!pileups.length) {
      list.innerHTML = `<div class="empty-note">No cross-vendor pile-ups detected in this partial sample. A larger dataset (full GBFS snapshot) may surface more.</div>`;
      return;
    }
    list.innerHTML = pileups.map(c => `
      <div class="pileup-item">
        <div class="id">${esc(c.id)}</div>
        <div class="meta">${c.vehicles.length} vehicles · ${esc(c.companies.join(", "))}</div>
        <div class="meta">${c.lat.toFixed(5)}, ${c.lng.toFixed(5)}</div>
      </div>
    `).join("");
  }
  buildPileupList();

})();
</script>
